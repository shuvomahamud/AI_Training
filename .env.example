# App connects through PgBouncer (transaction mode with verified TLS).
# TLS is configured with the CA and server name below. Do not put sslmode in
# these URLs because Drizzle Kit's URL-only mode can discard custom CA options.
DATABASE_URL=postgres://USER:PASSWORD@db.example.com:6432/DBNAME

# Direct Postgres (session mode). Used by migrations only.
# Prefer Tailscale or an SSH tunnel, not the public internet.
DIRECT_DATABASE_URL=postgres://USER:PASSWORD@db.example.com:5432/DBNAME

# Base64-encoded PEM for the private CA that signs the database certificate.
DATABASE_CA_CERT_BASE64=
# Certificate DNS name, even when DATABASE_URL uses an IP address.
DATABASE_TLS_SERVERNAME=tonu-vps

# 32+ random bytes, base64. Example generation:
# bun -e "console.log(crypto.getRandomValues(Buffer.alloc(32)).toString('base64'))"
SESSION_SECRET=

# VPS deployment: private local document storage. The service account must own
# this directory. When set, this takes precedence over Vercel Blob.
LOCAL_STORAGE_ROOT=/var/lib/ai-learning/uploads

# Vercel deployment alternative: provided by the Vercel Blob integration.
# Leave unset when LOCAL_STORAGE_ROOT is configured.
BLOB_READ_WRITE_TOKEN=

# Consumed by scripts/seed-admin.ts
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
