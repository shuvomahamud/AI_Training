[Unit]
Description=Encrypted backup of AI Learning application files
After=local-fs.target

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/ai-learning.env
ExecStart=/usr/local/sbin/ai-learning-restic-backup
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/ai-learning-restic
